# Required. Server-side variables; never use a Supabase service-role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional address autocomplete. Requires Mapbox permanent geocoding entitlement.
# Manual full-address entry works without this key.
MAPBOX_ACCESS_TOKEN=
